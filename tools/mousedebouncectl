#!/bin/sh
set -eu

LABEL="io.mouse-debounce.MouseDebounce"
DOMAIN="gui/$(id -u)"
SERVICE="$DOMAIN/$LABEL"
APP="$HOME/Applications/MouseDebounce.app"
BIN="$APP/Contents/MacOS/MouseDebounce"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/MouseDebounce.log"
ERRLOG="$HOME/Library/Logs/MouseDebounce.err.log"
SOURCE_APP="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/build/MouseDebounce.app"
ACCESSIBILITY_URL="x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"

usage() {
    cat <<USAGE
Usage: $0 COMMAND

Commands:
  install    copy the app to ~/Applications and register the LaunchAgent
  grant      ask for Accessibility and open its System Settings pane
  start      start the registered service
  stop       stop it cleanly with SIGTERM
  restart    restart it
  status     show registered/running/stopped status and recent failure logs
  logs       tail stdout/stderr logs
  uninstall  unregister service and remove installed app/plist (keeps config)
USAGE
}

loaded() {
    launchctl print "$SERVICE" >/dev/null 2>&1
}

install_service() {
    if [ ! -d "$SOURCE_APP" ]; then
        echo "Missing $SOURCE_APP; run 'make app' first." >&2
        exit 1
    fi
    mkdir -p "$HOME/Applications" "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
    if loaded; then
        launchctl bootout "$SERVICE" >/dev/null 2>&1 || true
    fi
    rm -rf "$APP"
    cp -R "$SOURCE_APP" "$APP"

    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$BIN</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>$LABEL</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardOutPath</key>
    <string>$LOG</string>
    <key>StandardErrorPath</key>
    <string>$ERRLOG</string>
</dict>
</plist>
PLIST
    launchctl bootstrap "$DOMAIN" "$PLIST"
    echo "Installed and registered. Next: $0 grant ; $0 start"
}

field() {
    launchctl print "$SERVICE" 2>/dev/null | sed -n "s/^[[:space:]]*$1 = //p" | head -n 1
}

status_service() {
    if ! loaded; then
        echo "MouseDebounce: NOT REGISTERED"
        exit 1
    fi

    state="$(field state || true)"
    pid="$(field pid || true)"
    exit_code="$(field 'last exit code' || true)"

    if [ -n "$pid" ]; then
        echo "MouseDebounce: RUNNING (pid $pid; launchd state=${state:-unknown})"
        return 0
    fi

    echo "MouseDebounce: STOPPED (registered; launchd state=${state:-unknown})"
    if [ -n "$exit_code" ]; then
        echo "Last exit code: $exit_code"
        case "$exit_code" in
            0|'(never exited)') ;;
            *)
                echo "Recent log output:"
                [ -f "$LOG" ] && tail -n 8 "$LOG" || true
                [ -f "$ERRLOG" ] && tail -n 8 "$ERRLOG" || true
                ;;
        esac
    fi
}

case "${1:-}" in
    install)
        install_service
        ;;
    grant)
        if [ ! -d "$APP" ]; then
            echo "Not installed; run '$0 install' first." >&2
            exit 1
        fi
        # Launch through LaunchServices so TCC attributes the request to the app bundle.
        open -n "$APP" --args --duration 1
        sleep 1
        # macOS may remember an earlier denial and suppress a repeat dialog.  Always
        # open the correct pane so the existing toggle can be enabled manually.
        open "$ACCESSIBILITY_URL" >/dev/null 2>&1 || true
        echo "Accessibility is the only permission Mouse Debounce needs."
        echo "Enable 'Mouse Debounce' in the pane that opened, then run '$0 start'."
        echo "If no dialog appeared, that usually means macOS remembered an earlier TCC decision."
        ;;
    start)
        if ! loaded; then
            echo "Not registered; run '$0 install' first." >&2
            exit 1
        fi
        launchctl kickstart "$SERVICE"
        sleep 0.2
        status_service
        ;;
    stop)
        if ! loaded; then
            echo "MouseDebounce: not registered"
            exit 1
        fi
        launchctl kill SIGTERM "$SERVICE" 2>/dev/null || true
        sleep 0.2
        status_service
        ;;
    restart)
        if ! loaded; then
            echo "Not registered; run '$0 install' first." >&2
            exit 1
        fi
        launchctl kickstart -k "$SERVICE"
        sleep 0.2
        status_service
        ;;
    status)
        status_service
        ;;
    logs)
        mkdir -p "$HOME/Library/Logs"
        touch "$LOG" "$ERRLOG"
        tail -f "$LOG" "$ERRLOG"
        ;;
    uninstall)
        if loaded; then launchctl bootout "$SERVICE" >/dev/null 2>&1 || true; fi
        rm -f "$PLIST"
        rm -rf "$APP"
        echo "Removed app and LaunchAgent. Config was intentionally kept."
        ;;
    *)
        usage
        exit 2
        ;;
esac
