#!/bin/sh
set -eu

LABEL="io.mouse-debounce.MouseDebounce"
DOMAIN="gui/$(id -u)"
SERVICE="$DOMAIN/$LABEL"
APP="$HOME/Applications/MouseDebounce.app"
BIN="$APP/Contents/MacOS/MouseDebounce"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="$HOME/Library/Logs/MouseDebounce.log"
ERRLOG="$HOME/Library/Logs/MouseDebounce.err.log"
MEASURE_LOG="$HOME/Library/Logs/MouseDebounce.measure.log"
MEASURE_PID="$HOME/Library/Application Support/MouseDebounce/measure.pid"
CONFIG="$HOME/Library/Application Support/MouseDebounce/config.args"
SOURCE_APP="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)/build/MouseDebounce.app"
ACCESSIBILITY_URL="x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"

usage() {
    cat <<USAGE
Usage: $0 COMMAND [ARGS...]

Commands:
  install              copy app to ~/Applications and register LaunchAgent
  grant                request Accessibility and open its System Settings pane
  reset-accessibility  reset stale Accessibility approval for this bundle ID
  start                start registered debounce service
  stop                 stop registered debounce service
  restart              restart registered debounce service
  status               show registered/running/stopped status
  measure [SEC]        live measurement; default 60 s; raw filter is paused/restored
  save [APP ARGS...]   save config.args and exit; restart service if it was running
  config               print saved config
  logs                 follow service stdout/stderr logs
  uninstall            unregister service and remove app/plist (keeps config/logs)
USAGE
}

loaded() {
    launchctl print "$SERVICE" >/dev/null 2>&1
}

field() {
    launchctl print "$SERVICE" 2>/dev/null | sed -n "s/^[[:space:]]*$1 = //p" | head -n 1
}

service_pid() {
    field pid || true
}

service_running() {
    [ -n "$(service_pid)" ]
}

wait_stopped() {
    i=0
    while service_running && [ "$i" -lt 30 ]; do
        sleep 0.1
        i=$((i + 1))
    done
}

stop_quiet() {
    if loaded && service_running; then
        launchctl kill SIGTERM "$SERVICE" >/dev/null 2>&1 || true
        wait_stopped
    fi
}

start_quiet() {
    if loaded; then
        launchctl kickstart "$SERVICE" >/dev/null 2>&1 || true
    fi
}

install_service() {
    if [ ! -d "$SOURCE_APP" ]; then
        echo "Missing $SOURCE_APP; run 'make app' first." >&2
        exit 1
    fi
    mkdir -p "$HOME/Applications" "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
    if loaded; then
        launchctl bootout "$SERVICE" >/dev/null 2>&1 || true
    fi
    rm -rf "$APP"
    cp -R "$SOURCE_APP" "$APP"

    cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$BIN</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>$LABEL</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardOutPath</key>
    <string>$LOG</string>
    <key>StandardErrorPath</key>
    <string>$ERRLOG</string>
</dict>
</plist>
PLIST
    launchctl bootstrap "$DOMAIN" "$PLIST"
    echo "Installed and registered. Next: $0 grant ; $0 start"
}

status_service() {
    if ! loaded; then
        echo "MouseDebounce: NOT REGISTERED"
        return 1
    fi

    state="$(field state || true)"
    pid="$(service_pid)"
    exit_code="$(field 'last exit code' || true)"

    if [ -n "$pid" ]; then
        echo "MouseDebounce: RUNNING (pid $pid; launchd state=${state:-unknown})"
        return 0
    fi

    echo "MouseDebounce: STOPPED (registered; launchd state=${state:-unknown})"
    if [ -n "$exit_code" ]; then
        echo "Last exit code: $exit_code"
        case "$exit_code" in
            0|'(never exited)') ;;
            *)
                echo "Recent log output:"
                [ -f "$LOG" ] && tail -n 8 "$LOG" || true
                [ -f "$ERRLOG" ] && tail -n 8 "$ERRLOG" || true
                ;;
        esac
    fi
}

measure_cleanup() {
    code=$?
    trap - INT TERM HUP EXIT

    if [ -f "$MEASURE_PID" ]; then
        mpid="$(cat "$MEASURE_PID" 2>/dev/null || true)"
        if [ -n "$mpid" ] && kill -0 "$mpid" 2>/dev/null; then
            kill -TERM "$mpid" 2>/dev/null || true
        fi
    fi
    [ -n "${TAIL_PID:-}" ] && kill "$TAIL_PID" 2>/dev/null || true
    [ -n "${OPEN_PID:-}" ] && kill "$OPEN_PID" 2>/dev/null || true
    rm -f "$MEASURE_PID"

    if [ "${WAS_RUNNING:-0}" -eq 1 ]; then
        start_quiet
        echo "Restored debounce service."
    fi
    return "$code"
}

measure_session() {
    if [ ! -d "$APP" ]; then
        echo "Not installed; run '$0 install' first." >&2
        exit 1
    fi

    duration="${1:-60}"
    if [ "$#" -gt 0 ]; then shift; fi

    mkdir -p "$HOME/Library/Logs" "$(dirname "$MEASURE_PID")"
    : > "$MEASURE_LOG"
    rm -f "$MEASURE_PID"

    WAS_RUNNING=0
    if loaded && service_running; then
        WAS_RUNNING=1
    fi
    # Measurement must see raw physical events, never our filtered/reposted stream.
    stop_quiet
    echo "Debounce service is stopped for raw measurement."

    trap measure_cleanup INT TERM HUP EXIT

    # The app writes line-buffered output to the log; tail mirrors it live here.
    tail -n +1 -f "$MEASURE_LOG" &
    TAIL_PID=$!

    open -n -W "$APP" --args \
        --no-config --measure --buttons left,right,middle \
        --duration "$duration" --output "$MEASURE_LOG" --pid-file "$MEASURE_PID" "$@" &
    OPEN_PID=$!

    set +e
    wait "$OPEN_PID"
    result=$?
    set -e
    sleep 0.15

    kill "$TAIL_PID" 2>/dev/null || true
    wait "$TAIL_PID" 2>/dev/null || true
    TAIL_PID=""
    OPEN_PID=""
    rm -f "$MEASURE_PID"

    trap - INT TERM HUP EXIT
    if [ "$WAS_RUNNING" -eq 1 ]; then
        start_quiet
        echo "Restored debounce service."
    fi
    echo "Measurement log: $MEASURE_LOG"
    return "$result"
}

save_config() {
    if [ ! -x "$BIN" ]; then
        echo "Not installed; run '$0 install' first." >&2
        exit 1
    fi
    was=0
    if loaded && service_running; then was=1; fi

    "$BIN" --save-config-and-exit "$@"

    if [ "$was" -eq 1 ]; then
        launchctl kickstart -k "$SERVICE" >/dev/null 2>&1 || true
        sleep 0.2
        echo "Restarted running debounce service with the saved settings."
        status_service || true
    else
        echo "Service was not running; settings will apply next time it starts."
    fi
}

case "${1:-}" in
    install)
        install_service
        ;;
    grant)
        if [ ! -d "$APP" ]; then
            echo "Not installed; run '$0 install' first." >&2
            exit 1
        fi
        open -n "$APP" --args --duration 1
        sleep 1
        open "$ACCESSIBILITY_URL" >/dev/null 2>&1 || true
        echo "Accessibility is the only permission Mouse Debounce needs."
        echo "Enable 'Mouse Debounce' in the pane that opened, then run '$0 start'."
        ;;
    reset-accessibility)
        tccutil reset Accessibility "$LABEL"
        echo "Reset Accessibility approval for $LABEL."
        echo "Now run: $0 grant"
        ;;
    start)
        if ! loaded; then
            echo "Not registered; run '$0 install' first." >&2
            exit 1
        fi
        launchctl kickstart "$SERVICE"
        sleep 0.2
        status_service
        ;;
    stop)
        if ! loaded; then
            echo "MouseDebounce: not registered"
            exit 1
        fi
        stop_quiet
        status_service
        ;;
    restart)
        if ! loaded; then
            echo "Not registered; run '$0 install' first." >&2
            exit 1
        fi
        launchctl kickstart -k "$SERVICE"
        sleep 0.2
        status_service
        ;;
    status)
        status_service
        ;;
    measure)
        shift
        measure_session "$@"
        ;;
    save)
        shift
        save_config "$@"
        ;;
    config)
        if [ -f "$CONFIG" ]; then
            cat "$CONFIG"
        else
            echo "No saved config: $CONFIG"
            exit 1
        fi
        ;;
    logs)
        mkdir -p "$HOME/Library/Logs"
        touch "$LOG" "$ERRLOG"
        tail -f "$LOG" "$ERRLOG"
        ;;
    uninstall)
        if loaded; then launchctl bootout "$SERVICE" >/dev/null 2>&1 || true; fi
        rm -f "$PLIST"
        rm -rf "$APP"
        echo "Removed app and LaunchAgent. Config/logs were intentionally kept."
        ;;
    *)
        usage
        exit 2
        ;;
esac
